# ---------------------------------------------------------------------------
# TMDB API (https://developer.themoviedb.org/docs/getting-started)
# Provide EITHER the v4 "API Read Access Token" (preferred, used as Bearer)
# OR the v3 api_key. The client will prefer the access token if present.
# ---------------------------------------------------------------------------
VITE_TMDB_ACCESS_TOKEN=
VITE_TMDB_API_KEY=
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ---------------------------------------------------------------------------
# Firebase (https://console.firebase.google.com) - Project settings > General
# Used ONLY for authentication (email/password) as required by the brief.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
